{
 "label": "Documentary Short",
 "defn": "A nonfiction short of the sound era observing people, work and social life at first hand — portraits, social observation and sport — not made as sponsored, scientific, political, poetic, essay, arts or ethnographic film (Le Sang des bêtes, Les Raquetteurs, Talking Heads, Period. End of Sentence.).",
 "axis": "by era for portrait and social shorts, then sport",
 "secs": [
  "Portrait & Social Shorts to 1959",
  "Portrait & Social Shorts 1960–1979",
  "Portrait & Social Shorts 1980–1999",
  "Portrait & Social Shorts 2000–2014",
  "Portrait & Social Shorts since 2015",
  "Sport Shorts"
 ],
 "new_leaves": [
  {
   "key": "NEW1",
   "label": "Political Documentary Short",
   "breadth": "Short militant, activist and social-issue documentaries.",
   "defn": "A documentary short made to argue, mobilise or bear witness on a political or social cause — militant and revolutionary newsreels, anticolonial and activist films, war and social-issue reportage (Misère au Borinage, Afrique 50, Now, Hanoi Tuesday 13th, The White Helmets).",
   "aliases": "militant film; activist documentary short; social-issue documentary short",
   "src": [
    [
     "https://en.wikipedia.org/wiki/Political_cinema",
     "Wikipedia"
    ]
   ],
   "axis": "by era: interwar and postwar militant film, the 1960s revolutionary and Third Cinema shorts, the 1970s collectives, then later activism",
   "secs": [
    "Militant Shorts to 1959",
    "Revolutionary & Third Cinema Shorts 1960–1969",
    "Activist & Collective Shorts 1970–1979",
    "Activist & Issue Shorts 1980–2009",
    "Activist & Issue Shorts since 2010"
   ]
  },
  {
   "key": "NEW2",
   "label": "Poetic Documentary Short",
   "breadth": "Short documentaries organised by rhythm, image and mood rather than argument: city symphonies and lyrical studies of place and labour.",
   "defn": "A documentary short shaped by visual rhythm, montage and mood instead of exposition — city symphonies, lyrical studies of landscape, seasons and work (Manhatta, Rain, À propos de Nice, Islands of Fire, Beginning).",
   "aliases": "city symphony short; lyrical documentary",
   "src": [
    [
     "https://en.wikipedia.org/wiki/Poetic_documentary",
     "Wikipedia"
    ]
   ],
   "axis": "city symphonies first, then poetic documentary by era",
   "secs": [
    "City Symphonies & Street Films",
    "Poetic Documentary to 1969",
    "Poetic Documentary 1970–1999",
    "Poetic Documentary since 2000"
   ]
  },
  {
   "key": "NEW3",
   "label": "Essay Film Short",
   "breadth": "Short first-person and reflective nonfiction films that think through images, memory and history.",
   "defn": "A nonfiction short that reflects in a personal, argumentative voice, working through memory, history and images themselves (Night and Fog, The House Is Black, Reassemblage, Isle of Flowers, History and Memory).",
   "aliases": "short essay film; video essay; film essay",
   "src": [
